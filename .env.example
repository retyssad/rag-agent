# demo: 可离线演示，界面始终显示模拟标签。live: 真实服务，缺配置时明确失败。
APP_MODE=demo
DATABASE_URL=sqlite:///./.local/coach.db
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 对话模型（阿里百炼 OpenAI 兼容接口）
CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.8-flash
DASHSCOPE_API_KEY=
# 中国内地站；海外站请同时调整 embeddings 和 rerank URL。
BAILIAN_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
BAILIAN_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
BAILIAN_RERANK_MODEL=gte-rerank-v2
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=coach_evidence_v1
MODEL_TIMEOUT=60
MAX_AGENT_STEPS=10
# 单次评估的候选上限；超过时结果会如实标明未参与比较的候选数量。
MAX_CANDIDATES=30
# 日志：json 为单行结构化日志（含 request_id/run_id 与耗时），text 便于本机阅读。
LOG_LEVEL=INFO
LOG_FORMAT=json
RETRIEVAL_TOP_K=15
RRF_K=60
RERANK_TOP_N=8
MAX_PARENTS=6
MAX_CONTEXT_CHARS=9000
