  "documents": [
    {
      "id": "coach-01-teaching",
      "coach_id": "coach-01",
      "title": "林知夏教学资料（虚构）",
      "source": "demo://coaches/coach-01/teaching",
      "document_type": "teaching",
      "version": "1",
      "content": "# 教学方式\n\n林知夏面向减脂目标提供循序渐进的基础训练。对新手耐心，习惯逐步解释动作，先讲解再示范，并允许学员重复提问。",
      "is_demo": true
    },
    {
      "id": "coach-01-case",
      "coach_id": "coach-01",
      "title": "林知夏训练案例（虚构）",
      "source": "demo://coaches/coach-01/case",
      "document_type": "case",
      "version": "1",
      "content": "# 训练案例\n\n一份虚构的减脂教学案例记录：学员先学习基础动作，再根据训练反馈逐步调整组数与强度。案例只用于演示资料引用，不代表真实效果，也不能推算成功率。在另一个虚构案例中，林知夏陪同一位自述膝盖不适且已获得医生运动许可的学员，使用低冲击活动、控制动作幅度，并记录不适反馈。这是训练调整记录，不是医疗诊断或康复资质。",
      "is_demo": true
    },
